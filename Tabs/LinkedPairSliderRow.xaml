<UserControl x:Class="KRetouchStudio.Tabs.LinkedPairSliderRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PairRowLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PairSideLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PairValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PairLinkToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource SurfacePrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="LinkBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource PanelSelectedBg}"/>
                                <Setter TargetName="LinkBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource PanelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding ElementName=Root, Path=Label}"
                   Style="{StaticResource PairRowLabelStyle}"/>
        <TextBlock Grid.Column="1"
                   Text="L"
                   Style="{StaticResource PairSideLabelStyle}"/>
        <Slider Grid.Column="2"
                Minimum="0"
                Maximum="100"
                TickFrequency="1"
                Value="{Binding ElementName=Root, Path=LeftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Column="3"
                   Text="{Binding ElementName=Root, Path=LeftValue, StringFormat={}{0:0}}"
                   Style="{StaticResource PairValueStyle}"/>
        <ToggleButton x:Name="LinkButton"
                      Grid.Column="4"
                      Style="{StaticResource PairLinkToggleStyle}"
                      IsChecked="{Binding ElementName=Root, Path=IsLinked, Mode=TwoWay}"/>
        <TextBlock Grid.Column="5"
                   Text="R"
                   Style="{StaticResource PairSideLabelStyle}"/>
        <Slider Grid.Column="6"
                Minimum="0"
                Maximum="100"
                TickFrequency="1"
                Value="{Binding ElementName=Root, Path=RightValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Column="7"
                   Text="{Binding ElementName=Root, Path=RightValue, StringFormat={}{0:0}}"
                   Style="{StaticResource PairValueStyle}"/>
    </Grid>
</UserControl>
