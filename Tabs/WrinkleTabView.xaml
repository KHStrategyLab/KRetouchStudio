<UserControl x:Class="KRetouchStudio.Tabs.WrinkleTabView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:KRetouchStudio.Tabs">
    <UserControl.Resources>
        <Style x:Key="WrinkleHeaderResetButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SurfacePrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SlotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SlotBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SlotBorder" Property="Background" Value="{StaticResource PanelBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SlotBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WrinkleRowLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WrinkleValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WrinkleSliderStyle" TargetType="{x:Type Slider}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WrinkleSlider_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="WrinkleSlider_PreviewMouseLeftButtonUp"/>
            <EventSetter Event="ValueChanged" Handler="WrinkleSlider_ValueChanged"/>
            <EventSetter Event="KeyUp" Handler="WrinkleSlider_KeyUp"/>
        </Style>
    </UserControl.Resources>

    <Expander x:Name="WrinkleExpander" Header="Wrinkle" Expanded="Expander_Expanded">
        <Expander.Tag>
            <Button Content="↶"
                    IsEnabled="{Binding ElementName=Root, Path=CanResetWrinkleTab}"
                    ToolTipService.ShowOnDisabled="True"
                    Style="{StaticResource WrinkleHeaderResetButtonStyle}"
                    Click="ResetWrinkleTabButton_Click"
                    ToolTip="Reset Wrinkle tab values"/>
        </Expander.Tag>
        <StackPanel>
            <Grid Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Forehead" Style="{StaticResource WrinkleRowLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding ElementName=Root, Path=Forehead, StringFormat={}{0:0}}" Style="{StaticResource WrinkleValueStyle}"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" TickFrequency="1"
                        Style="{StaticResource WrinkleSliderStyle}"
                        Tag="Forehead"
                        Value="{Binding ElementName=Root, Path=Forehead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Grid Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Frown" Style="{StaticResource WrinkleRowLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding ElementName=Root, Path=Frown, StringFormat={}{0:0}}" Style="{StaticResource WrinkleValueStyle}"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" TickFrequency="1"
                        Style="{StaticResource WrinkleSliderStyle}"
                        Tag="Frown"
                        Value="{Binding ElementName=Root, Path=Frown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <tabs:LinkedPairSliderRow Label="Crow's Feet"
                                      Margin="0,0,0,9"
                                      UseStackedLayout="True"
                                      LeftOperationId="LeftCrowsFeet"
                                      RightOperationId="RightCrowsFeet"
                                      SliderPreviewChanged="PairSlider_SliderPreviewChanged"
                                      SliderCommitted="PairSlider_SliderCommitted"
                                      LeftValue="{Binding ElementName=Root, Path=LeftCrowsFeet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      RightValue="{Binding ElementName=Root, Path=RightCrowsFeet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsLinked="{Binding ElementName=Root, Path=CrowsFeetLinked, Mode=TwoWay}"/>

            <tabs:LinkedPairSliderRow Label="Under Eye"
                                      Margin="0,0,0,9"
                                      UseStackedLayout="True"
                                      LeftOperationId="LeftUnderEye"
                                      RightOperationId="RightUnderEye"
                                      SliderPreviewChanged="PairSlider_SliderPreviewChanged"
                                      SliderCommitted="PairSlider_SliderCommitted"
                                      LeftValue="{Binding ElementName=Root, Path=LeftUnderEye, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      RightValue="{Binding ElementName=Root, Path=RightUnderEye, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsLinked="{Binding ElementName=Root, Path=UnderEyeLinked, Mode=TwoWay}"/>

            <tabs:LinkedPairSliderRow Label="Bunny"
                                      Margin="0,0,0,9"
                                      UseStackedLayout="True"
                                      LeftOperationId="LeftBunny"
                                      RightOperationId="RightBunny"
                                      SliderPreviewChanged="PairSlider_SliderPreviewChanged"
                                      SliderCommitted="PairSlider_SliderCommitted"
                                      LeftValue="{Binding ElementName=Root, Path=LeftBunny, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      RightValue="{Binding ElementName=Root, Path=RightBunny, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsLinked="{Binding ElementName=Root, Path=BunnyLinked, Mode=TwoWay}"/>

            <tabs:LinkedPairSliderRow Label="Smile Fold"
                                      Margin="0,0,0,9"
                                      UseStackedLayout="True"
                                      LeftOperationId="LeftSmileFold"
                                      RightOperationId="RightSmileFold"
                                      SliderPreviewChanged="PairSlider_SliderPreviewChanged"
                                      SliderCommitted="PairSlider_SliderCommitted"
                                      LeftValue="{Binding ElementName=Root, Path=LeftSmileFold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      RightValue="{Binding ElementName=Root, Path=RightSmileFold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsLinked="{Binding ElementName=Root, Path=SmileFoldLinked, Mode=TwoWay}"/>

            <tabs:LinkedPairSliderRow Label="Marionette"
                                      Margin="0,0,0,9"
                                      UseStackedLayout="True"
                                      LeftOperationId="LeftMarionette"
                                      RightOperationId="RightMarionette"
                                      SliderPreviewChanged="PairSlider_SliderPreviewChanged"
                                      SliderCommitted="PairSlider_SliderCommitted"
                                      LeftValue="{Binding ElementName=Root, Path=LeftMarionette, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      RightValue="{Binding ElementName=Root, Path=RightMarionette, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsLinked="{Binding ElementName=Root, Path=MarionetteLinked, Mode=TwoWay}"/>

            <Grid Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lip Lines" Style="{StaticResource WrinkleRowLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding ElementName=Root, Path=LipLines, StringFormat={}{0:0}}" Style="{StaticResource WrinkleValueStyle}"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" TickFrequency="1"
                        Style="{StaticResource WrinkleSliderStyle}"
                        Tag="LipLines"
                        Value="{Binding ElementName=Root, Path=LipLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Grid Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Chin Crease" Style="{StaticResource WrinkleRowLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding ElementName=Root, Path=ChinCrease, StringFormat={}{0:0}}" Style="{StaticResource WrinkleValueStyle}"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" TickFrequency="1"
                        Style="{StaticResource WrinkleSliderStyle}"
                        Tag="ChinCrease"
                        Value="{Binding ElementName=Root, Path=ChinCrease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Neck" Style="{StaticResource WrinkleRowLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding ElementName=Root, Path=Neck, StringFormat={}{0:0}}" Style="{StaticResource WrinkleValueStyle}"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" TickFrequency="1"
                        Style="{StaticResource WrinkleSliderStyle}"
                        Tag="Neck"
                        Value="{Binding ElementName=Root, Path=Neck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
