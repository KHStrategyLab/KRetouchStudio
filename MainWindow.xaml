                            Background="{StaticResource SurfacePrimary}"
                            BorderBrush="{StaticResource MenuBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="14"
                            MinHeight="150">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="History"
                                           Foreground="{StaticResource TextMain}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding HistoryPanelStatusText}"
                                           Foreground="{StaticResource TextSub}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,10"/>
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceCanvasDark}"
                                    BorderBrush="{StaticResource MenuBorder}"
                                    BorderThickness="1"
                                    Padding="10">
                                <Grid>
                                    <Grid Visibility="{Binding HistoryPanelEmptyVisibility}">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="No edit history yet."
                                                       Foreground="{StaticResource TextSub}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="Open a photo and start editing to build steps here."
                                                       Foreground="{StaticResource TextSub}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="Applied tool actions and snapshots will appear in this panel."
                                                       Foreground="{StaticResource TextSub}"/>
                                        </StackPanel>
                                    </Grid>
                                     <ListBox Visibility="{Binding HistoryPanelListVisibility}"
                                              ItemsSource="{Binding HistoryPanelItems}"
                                              SelectedItem="{Binding SelectedHistoryPanelItem, Mode=TwoWay}"
                                              MouseDoubleClick="HistoryPanelListBox_MouseDoubleClick"
                                              MaxHeight="216"
                                              Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextMain}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="Height" Value="64"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource MenuBorder}"
                                                        BorderThickness="1"
                                                        Background="{StaticResource SurfacePrimary}"
                                                        Padding="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{StaticResource TextMain}"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Background="{StaticResource PanelSelectedBg}"
                                                                        BorderBrush="{StaticResource Accent}"
                                                                        BorderThickness="1"
                                                                        Padding="5,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="{x:Type Border}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="Current"
                                                                               Foreground="{StaticResource Accent}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Foreground="{StaticResource TextSub}"
                                                                       FontSize="12"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TimeLabel}"
                                                                   Foreground="{StaticResource TextSub}"
                                                                   FontSize="11"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
