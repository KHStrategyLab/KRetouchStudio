<Window x:Class="KRetouchStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:KRetouchStudio.Tabs"
        Title="KRetouch Studio"
        Width="1500"
        Height="950"
        MinWidth="900"
        MinHeight="720"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        AllowDrop="True"
         DragEnter="Window_DragEnter"
         DragOver="Window_DragOver"
         Drop="Window_Drop"
         Background="{StaticResource WindowBg}"
         Icon="Assets/AppIcon.ico">
    <Window.Resources>
        <Style x:Key="AppSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="1.5"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{StaticResource SliderThumbFill}"
                                BorderBrush="{StaticResource SliderThumbBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource SliderTrackFill}"/>
            <Setter Property="Background" Value="{StaticResource SliderTrackBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center"
                              SnapsToDevicePixels="True">
                            <Border Height="3"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AppSliderTrackButtonStyle}"
                                                  Background="{TemplateBinding Foreground}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AppSliderTrackButtonStyle}"
                                                  Background="{TemplateBinding Background}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="{StaticResource MenuBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource MenuBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="{StaticResource MenuBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="IconColumn" Width="0"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="CheckColumn" Width="0"/>
                                    <ColumnDefinition x:Name="ArrowColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckGlyph"
                                           Grid.Column="2"
                                           Text="✓"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           FontFamily="Segoe UI"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="Collapsed"/>
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Width="5"
                                      Height="8"
                                      Margin="8,0,8,0"
                                      Fill="{StaticResource TextSub}"
                                      Data="M 0 0 L 5 4 L 0 8 Z"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade">
                                    <Border x:Name="SubMenuBorder"
                                            Background="{StaticResource MenuBg}"
                                            BorderBrush="{StaticResource MenuBorder}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsCheckable" Value="True">
                                    <Setter TargetName="CheckColumn" Property="Width" Value="18"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                    <Setter TargetName="MenuItemBorder" Property="BorderThickness" Value="0"/>
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="IconColumn" Property="Width" Value="8"/>
                                <Setter TargetName="ArrowColumn" Property="Width" Value="22"/>
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="IconColumn" Property="Width" Value="8"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource MenuItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource MenuItemPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource MenuItemHoverBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource MenuItemPressedBg}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{StaticResource MenuBorder}"/>
        </Style>
        <Style x:Key="RetouchExpanderHeaderToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource SurfacePrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource SurfacePrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PanelBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolboxButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppActionButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="{x:Type Expander}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource SurfacePrimary}"
                                        BorderBrush="{StaticResource MenuBorder}"
                                        BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="HeaderSite"
                                                      Style="{StaticResource RetouchExpanderHeaderToggleStyle}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ContentPresenter x:Name="HeaderContent"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True"/>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="HeaderActionSite"
                                                          Grid.Column="1"
                                                          Content="{TemplateBinding Tag}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Margin="12"
                                                  Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSite" Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                MinHeight="56"
                Background="{StaticResource SurfacePrimary}"
                BorderBrush="{StaticResource MenuBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="KRetouch Studio"
                                   Foreground="{StaticResource TextMain}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   FontSize="18"/>
                        <TextBlock Text="{Binding AppVersionDisplayText}"
                                   Foreground="{StaticResource TextSub}"
                                   FontSize="12"
                                   Margin="8,2,0,0"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource SurfaceSecondary}"
                                BorderBrush="{StaticResource MenuBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="10,1,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="MediaPipe path ready"
                                       Foreground="{StaticResource TextSub}"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedPhotoStatusText}"
                               Foreground="{StaticResource TextSub}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <WrapPanel Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,6,0,10">
                    <!-- 수정전 문의 -->
                    <Button Style="{StaticResource AppActionButtonStyle}" Content="사진 불러오기" Click="LoadPhotosButton_Click" Margin="4"/>
                    <Button Style="{StaticResource AppActionButtonStyle}"
                            Content="저장"
                            Click="SavePhotoButton_Click"
                            IsEnabled="{Binding CanSaveCurrentPhoto}"
                            Margin="4"/>
                    <Button Style="{StaticResource AppActionButtonStyle}"
                            Content="MediaPipe Test"
                            Click="MediaPipeTestButton_Click"
                            Margin="4"/>
                    <Button Style="{StaticResource AppActionButtonStyle}"
                            Content="{Binding MediaPipeAllPointDebugButtonText}"
                            Click="MediaPipeAllPointDebugButton_Click"
                            Margin="4"/>
                    <TextBlock Text="{Binding MediaPipeStatusText}"
                               Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center"
                               Margin="8,4,4,4"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Background="{StaticResource SurfaceSecondary}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="0,0,0,1">
                <Menu FontSize="13"
                      Padding="8,0">
                <MenuItem Header="File">
                    <MenuItem Header="Open" Click="LoadPhotosButton_Click"/>
                    <MenuItem Header="Save"
                              Click="SavePhotoButton_Click"
                              IsEnabled="{Binding CanSaveCurrentPhoto}"/>
                    <MenuItem Header="Save As..."
                              Click="SavePhotoAsMenuItem_Click"
                              IsEnabled="{Binding CanSaveCurrentPhoto}"/>
                    <MenuItem Header="Work Area" Click="WorkAreaMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Prefs">
                    <MenuItem Header="Sort">
                        <MenuItem Header="Name A-Z" Click="SortNameAscendingMenuItem_Click"/>
                        <MenuItem Header="Name Z-A" Click="SortNameDescendingMenuItem_Click"/>
                        <MenuItem Header="Newest First" Click="SortNewestFirstMenuItem_Click"/>
                        <MenuItem Header="Oldest First" Click="SortOldestFirstMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="Color Management">
                        <MenuItem Header="Automatic"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsColorManagementAutomatic, Mode=OneWay}"
                                  Click="ColorManagementAutomaticMenuItem_Click"/>
                        <MenuItem Header="Manual Display Profile"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsColorManagementManual, Mode=OneWay}"
                                  Click="ColorManagementManualMenuItem_Click"/>
                        <MenuItem Header="Load ICC/ICM Profile..."
                                  Click="LoadColorManagementProfileMenuItem_Click"/>
                        <MenuItem Header="{Binding ManualColorManagementProfileText}"
                                  IsEnabled="False"/>
                        <MenuItem Header="Clear Manual Profile"
                                  IsEnabled="{Binding CanClearManualColorManagementProfile}"
                                  Click="ClearColorManagementProfileMenuItem_Click"/>
                        <MenuItem Header="Disabled"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsColorManagementDisabled, Mode=OneWay}"
                                  Click="ColorManagementDisabledMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="Mode">
                        <MenuItem Header="{Binding RuntimeWorkModeDisplayText}"
                                  IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Remember Photo History"
                              IsCheckable="True"
                              IsChecked="{Binding EnableEditorHistoryPersistence}"
                              Click="EditorHistoryPersistenceMenuItem_Click"/>
                    <Separator x:Name="DevelopmentPackageSeparator"
                               Visibility="Collapsed"/>
                    <MenuItem x:Name="DevelopmentPackageMenuItem"
                              Header="Development Package..."
                              Click="DevelopmentPackageMenuItem_Click"
                              Visibility="Collapsed"/>
                    <MenuItem Header="2"/>
                    <MenuItem Header="3"/>
                    <MenuItem Header="4"/>
                    <MenuItem Header="5"/>
                    <MenuItem Header="6"/>
                </MenuItem>
                <MenuItem Header="Window">
                    <MenuItem Header="History"
                              IsCheckable="True"
                              IsChecked="{Binding ShowHistoryPanel}"
                              Click="HistoryPanelMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Info">
                    <MenuItem Header="Info"/>
                    <MenuItem Header="About"/>
                    <MenuItem Header="Auto Check Updates"
                              IsCheckable="True"
                              IsChecked="{Binding AutoCheckUpdatesAtStartup}"
                              Click="AutoCheckUpdatesAtStartupMenuItem_Click"/>
                    <MenuItem Header="Updates" Click="UpdatesMenuItem_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PhotoListColumn" Width="260"/>
                <ColumnDefinition x:Name="ToolboxColumn" Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PhotoListPanel"
                    Grid.Column="0"
                    Background="{StaticResource SurfaceSecondary}"
                    BorderBrush="{StaticResource MenuBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding PhotoSelectionText}"
                           Foreground="{StaticResource TextSub}"
                           Margin="0,0,0,4"/>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding WorkAreaDisplayText}"
                                   Foreground="{StaticResource TextSub}"
                                   FontSize="12"
                                   Cursor="Hand"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="작업 폴더 열기"
                                   MouseLeftButtonUp="WorkAreaDisplayText_MouseLeftButtonUp"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource AppActionButtonStyle}"
                                Content="Refresh"
                                Width="68"
                                Height="30"
                                Margin="8,0,0,0"
                                Padding="0"
                                Click="RefreshWorkAreaButton_Click"
                                HorizontalAlignment="Right"
                                ToolTip="작업구역 다시 불러오기"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ScrollViewer.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Sort">
                                    <MenuItem Header="Name A-Z" Click="SortNameAscendingMenuItem_Click"/>
                                    <MenuItem Header="Name Z-A" Click="SortNameDescendingMenuItem_Click"/>
                                    <MenuItem Header="Newest First" Click="SortNewestFirstMenuItem_Click"/>
                                    <MenuItem Header="Oldest First" Click="SortOldestFirstMenuItem_Click"/>
                                </MenuItem>
                            </ContextMenu>
                        </ScrollViewer.ContextMenu>
                        <ItemsControl x:Name="PhotoListItemsControl"
                                      Focusable="True"
                                      ItemsSource="{Binding Photos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="8"
                                                    BorderThickness="1"
                                                    MouseLeftButtonUp="PhotoItem_MouseLeftButtonUp"
                                                    MouseLeftButtonDown="PhotoItem_MouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PanelSelectedBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="46"
                                                    Height="46"
                                                    Background="{StaticResource SurfaceCanvasDark}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayInfo}" Foreground="{StaticResource TextSub}" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfacePrimary}"
                    BorderBrush="{StaticResource MenuBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource AppActionButtonStyle}"
                            Content="{Binding PhotoListToggleText}"
                            Width="42"
                            Height="32"
                            Padding="0"
                            Margin="0,0,0,10"
                            FontSize="11"
                            Click="TogglePhotoListButton_Click"
                            ToolTip="사진 목록 접기/열기"/>
                    <WrapPanel Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top">
                    <Button x:Name="SelectToolButton"
                            Style="{StaticResource ToolboxButtonStyle}"
                            Tag="select"
                            Content="↖"
                            FontSize="17"
                            Click="ToolboxButton_Click"
                            ToolTip="Select"/>
                    <Button x:Name="PathSelectionToolButton"
                            Style="{StaticResource ToolboxButtonStyle}"
                            Tag="pathselect"
                            Content="A"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="ToolboxButton_Click"
                            ToolTip="Path / Direct Selection"/>
                    <Button x:Name="CropToolButton"
                            Style="{StaticResource ToolboxButtonStyle}"
                            Tag="crop"
                            Content="✂"
                            FontSize="16"
                            Click="ToolboxButton_Click"
                            ToolTip="Crop"/>
                    <Button x:Name="FrameToolButton"
                            Style="{StaticResource ToolboxButtonStyle}"
                            Tag="frame"
                            Content="▣"
                            FontSize="16"
                            Click="ToolboxButton_Click"
                            ToolTip="Frame"/>
                    <Button x:Name="LassoToolButton"
                            Style="{StaticResource ToolboxButtonStyle}"
                            Tag="lasso"
                            Content="L"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="ToolboxButton_Click"
                            ToolTip="Lasso"/>
                    <Button x:Name="RectangleToolButton"
                            Style="{StaticResource ToolboxButtonStyle}"
                            Tag="rectangle"
